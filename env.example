# Bot Configuration
IS_LOG_ENABLED=true
SCAN_INTERVAL=60000

# Order Settings
ORDER_LEVERAGE=1
ORDER_QUANTITY=10
MAX_ORDERS_PER_DAY=5
ORDER_LIMIT_PER_SCAN=2
